# Copy to .env.local for local development. Never commit real secrets.

# Set to "true" ONLY once the form is deployed somewhere that actually receives
# submissions (e.g. Netlify with Forms enabled). While false, the quote form
# validates input but clearly tells the visitor it is not connected yet.
VITE_FORMS_ENABLED=false

# Public site URL (used for reference only; canonical/OG tags live in index.html)
VITE_SITE_URL=https://promotions.example.com.au
