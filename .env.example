# Copy to .env.local for local development. Never commit .env.local.

# Web3Forms access key for the quote form (https://web3forms.com).
# Enquiries are emailed to the address verified on the Web3Forms account that owns this key.
# Leave empty and the form validates input but clearly tells the visitor it is not connected yet.
VITE_WEB3FORMS_ACCESS_KEY=

# Public site URL (used for reference only; canonical/OG tags live in index.html)
VITE_SITE_URL=https://promotions.example.com.au
